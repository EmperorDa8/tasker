{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Tasker - Activity Tracker & Google Drive Recap",
  "version": "1.3.0",
  "description": "Local-first activity tracker with branded PDF reports and optional sync to your own Google Drive.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "identity",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://tasker-extension.onrender.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  },
  "oauth2": {
    "client_id": "141484094117-9hnj10hh530mivabuoqjv7574tnmgu5m.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tasker Activity Tracker",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "log_win": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Log what you're doing right now as a win"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
